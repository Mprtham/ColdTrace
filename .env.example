# Copy to .env and fill in. Never commit .env.

# Neon connection string (use the psycopg driver prefix)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/coldtrace?sslmode=require

QDRANT_PATH=./qdrant_storage
# QDRANT_URL=http://localhost:6333

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ollama (local dev) | deepseek
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# DEEPSEEK_API_KEY=
# Set to the current production ID returned by GET https://api.deepseek.com/v1/models
# DEEPSEEK_MODEL=
