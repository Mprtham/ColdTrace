# Copy to .env and fill in. Never commit .env.

# Neon connection string, pasted exactly as Neon gives it (the driver prefix is added in src/config.py)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/coldtrace?sslmode=require

# Passwords for the roles created by scripts/setup_db.py (pick your own)
COLDTRACE_ADMIN_PASSWORD=
COLDTRACE_AGENT_PASSWORD=

QDRANT_PATH=./qdrant_storage
# QDRANT_URL=http://localhost:6333

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ollama (local dev) | deepseek | groq
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# DEEPSEEK_API_KEY=
# Set to the current production ID returned by GET https://api.deepseek.com/v1/models
# DEEPSEEK_MODEL=

# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
CLOCK_MODE=replay

# UI
API_URL=http://localhost:8000
# USD per million tokens, from the provider's pricing page (leave unset for Ollama)
# LLM_PRICE_IN_PER_MTOK=
# LLM_PRICE_OUT_PER_MTOK=

# Deploy hardening (see README "Deploy")
# API_KEY=          # when set, every API route but /health needs the X-API-Key header
# UI_PASSWORD=      # optional password screen in front of the UI
# QDRANT_API_KEY=   # only with QDRANT_URL (Qdrant Cloud); QDRANT_PATH=:memory: rebuilds at startup
